# Copy to .env.local for local dev. On Netlify: Site settings → Environment variables
# (do not commit real secrets; .env*.local is gitignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Prefer service role on the server only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site — use your Netlify URL in production (e.g. https://your-site.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SumUp Online Checkout (pay at booking) — required to take card payments
# Dashboard → Developers / API: https://developer.sumup.com/
# Create a Hosted Checkout with SUMUP_API_KEY + SUMUP_MERCHANT_CODE.
SUMUP_API_KEY=your_sumup_api_key
SUMUP_MERCHANT_CODE=your_merchant_code
# Optional: your SumUp login email (reference only; not sent to the API)
# SUMUP_PAY_TO_EMAIL=payments@yourdomain.at
# Optional: only needed if you later embed the SumUp card widget instead of Hosted Checkout
# NEXT_PUBLIC_SUMUP_PUBLIC_KEY=your_sumup_public_key
# Optional: any random string. If set, appended to the webhook URL registered
# with SumUp and checked on every callback — cheap defense-in-depth (payment
# status is always re-verified against SumUp's API regardless of this check).
# SUMUP_WEBHOOK_SECRET=

# Analytics — Plausible OR GA4 (pick one)
# Plausible: set domain only; script loads after cookie consent
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=viennagrandtours.com
# GA4: e.g. G-XXXXXXXXXX — loaded only after cookie consent
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional: email confirmation provider (Resend, Postmark, etc.)
# EMAIL_API_KEY=
# EMAIL_FROM=bookings@viennagrandtours.com

# --- Admin dashboard (/admin) ---------------------------------------------
# The admin area signs in with Supabase Auth (email + password) using the
# NEXT_PUBLIC_SUPABASE_* values above, and writes with SUPABASE_SERVICE_ROLE_KEY.
# No extra secrets are required — but the service role key is now mandatory in
# production, because admin writes bypass RLS. Keep it server-side only:
# never prefix it with NEXT_PUBLIC_.
#
# Create your admin user in the Supabase dashboard:
#   Authentication -> Users -> Add user -> "Auto Confirm User"
# See ADMIN.md for the full walkthrough.
