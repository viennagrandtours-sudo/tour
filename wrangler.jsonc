{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vienna-grand-tours",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Used to regenerate stale pages in the background. Must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vienna-grand-tours"
    }
  ],
  "kv_namespaces": [
    {
      // Page cache (KV namespace "vienna-grand-tours-cache" in the
      // Vienna Grand Tours account).
      "binding": "NEXT_INC_CACHE_KV",
      "id": "acf929a0229d41cca6c32b7888137320"
    }
  ],
  "images": {
    // next/image resizing through Cloudflare Images.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
